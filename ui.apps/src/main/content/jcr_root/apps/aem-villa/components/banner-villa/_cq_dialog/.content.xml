<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Banner - Villa"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs">
                <items jcr:primaryType="nt:unstructured">
                    <banner-tab
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Banner-Tab"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <well
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/well"
                                fieldLabel="Banner Tabb">
                                <items jcr:primaryType="nt:unstructured">
                                    <banmf
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                        composite="{Boolean}true"
                                        fieldLabel="Banner-Tabbb">
                                        <field
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container"
                                            name="./banmf">
                                            <items jcr:primaryType="nt:unstructured">
                                                <banner-image
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/foundation/form/fileupload"
                                                    allowUpload="{Boolean}false"
                                                    autoStart="{Boolean}true"
                                                    fieldLabel="Banner Image"
                                                    mimeTypes="[image/*]"
                                                    multiple="{Boolean}false"
                                                    name="./banImage"
                                                    required="{Boolean}true"
                                                    sizeLimit="10000000"/>
                                                <title
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="/libs/granite/ui/components/coral/foundation/form/textarea"
                                                    emptyText="-----------Enter Title-------------"
                                                    fieldLabel="Banner Title"
                                                    name="./banTitle"/>
                                                <description
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="/libs/granite/ui/components/coral/foundation/form/textarea"
                                                    emptyText="-----------Enter Description-------------"
                                                    fieldLabel="Banner Description"
                                                    name="./banDescription"/>
                                            </items>
                                        </field>
                                    </banmf>
                                </items>
                            </well>
                        </items>
                    </banner-tab>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
